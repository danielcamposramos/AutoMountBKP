license: GPL-3.0-or-later
doi: "10.5281/zenodo.23309097"
repository-code: "https://github.com/danielcamposramos/AutoMountBKP"
keywords:
  - "backup"
  - "rsync"
  - "udev"
  - "systemd"
  - "Samba"
  - "Linux"
  - "Debian"
